# Conexão usada pela aplicação (Supabase: "Transaction pooler", porta 6543)
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# Conexão direta usada pelas migrations (Supabase: "Session pooler", porta 5432)
DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Better Auth — gere com: npx @better-auth/cli secret  (ou qualquer string aleatória de 32+ caracteres)
BETTER_AUTH_SECRET=""
# URL pública do app (local: http://localhost:8080)
BETTER_AUTH_URL="http://localhost:8080"
